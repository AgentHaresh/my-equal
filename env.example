# My Equal settings. Copy this file to `.env` in the REPOSITORY ROOT (this folder, one level above `web/`).
#   cp env.example .env          (the same content is also provided as .env.example)
# web/next.config.ts loads ../.env and ../.server.env at startup. Values already in the environment win.
# Never commit a real `.env`.

# --- Required for the assistant ----------------------------------------------------------------
# Without a key the messenger still runs (sign-in, chats, calls, files), but every AI feature reports
# "offline": no memories, reminders from chats, answers, call-around, scam checks, photo or voice reading.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra
# Optional overrides for speech (defaults are tried in order in web/lib/voice.ts):
# OPENAI_STT_MODEL=
# OPENAI_TTS_MODEL=
# OPENAI_TTS_VOICE=

# --- Sign-in: Google only for now -------------------------------------------------------------
# An OAuth 2.0 "Web application" client ID from Google Cloud (APIs & Services > Credentials).
# Add every address the app is opened from as an "Authorized JavaScript origin",
# e.g. http://localhost:3000 and https://your-domain.
GOOGLE_CLIENT_ID=
# Phone sign-in (number + one-time code) is switched off in the code; these are kept for when it returns.
OTP_ONSCREEN_FALLBACK=off
FAST2SMS_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Secrets (a deployed server writes these to ../.server.env by itself; set them here locally) ---
# Signs the session cookie. Any long random string; without it sessions end when the server restarts.
SESSION_SECRET=change-me-to-a-long-random-string
# Lets test accounts sign in through the API and gives them a full made-up "sample life" to try.
TEST_LOGIN_SECRET=localtest
# Optional: 64 hex characters to encrypt the data on disk (AES-256-GCM). Leave empty locally.
DATA_KEY=

# --- Operating it (optional) ------------------------------------------------------------------
# Public address, used in invitation texts and notifications.
PUBLIC_URL=http://localhost:3000
# Where data is kept (default: web/data).
# DATA_DIR=
# Lets a scraper read /api/metrics with "Authorization: Bearer <token>".
METRICS_TOKEN=
# "silent" turns the JSON log lines off.
LOG_LEVEL=
