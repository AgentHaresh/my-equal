# Settings for My Equal. Copy this file to `.env` in this same folder and fill in the values.
# `.env` is ignored by git. Never commit real keys.

# --- Required -------------------------------------------------------------------------------
# The model that reads messages, answers questions, transcribes and speaks.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra

# --- Sign-in ---------------------------------------------------------------------------------
# Sign-in is by phone number and a one-time code. To send the code by SMS, set ONE service.
# Fast2SMS (India):
FAST2SMS_KEY=
# or Twilio (worldwide), all three:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# What happens when a text cannot be sent (no service, no credit):
#   off  refuse sign-in. Use this for real people.
#   on   show the code on the sign-in screen. For a demo only: it proves nothing about who holds the number.
OTP_ONSCREEN_FALLBACK=off

# Optional second way in: "Continue with Google".
GOOGLE_CLIENT_ID=

# --- Operating it ----------------------------------------------------------------------------
# The public address, used in invitation texts and notifications.
PUBLIC_URL=
# Lets a metrics scraper read /api/metrics without a signed-in session ("Authorization: Bearer <token>").
METRICS_TOKEN=
# "silent" turns the JSON log lines off.
LOG_LEVEL=

# --- Made by the server itself -----------------------------------------------------------------
# deploy/on-server.sh writes these once to `.server.env`. Do not set them by hand on a server.
# For local work you may set them here.
#   SESSION_SECRET     signs the session cookie (64 hex characters)
#   DATA_KEY           seals the data on disk with AES-256-GCM (64 hex characters). Lose it and the data cannot be read.
#   TEST_LOGIN_SECRET  lets the automated tests sign in as test accounts
